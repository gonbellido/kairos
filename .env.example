KAIROS_ENV=development
LOG_LEVEL=DEBUG

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

DATABASE_URL=postgresql+asyncpg://kairos:kairos_dev@localhost:5432/kairos

LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

SCORING_WEIGHT_RECENCY=0.25
SCORING_WEIGHT_RELEVANCE=0.35
SCORING_WEIGHT_OUTCOME=0.25
SCORING_WEIGHT_FREQUENCY=0.15

EVALUATOR_MODEL=gpt-4o-mini
EVALUATION_THRESHOLD=0.6

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# Obsidian Vault (ruta absoluta a la bóveda del coach)
# OBSIDIAN_VAULT=/Users/tu_usuario/Documents/Obsidian/MiVault

# Telegram Bot (para interactuar con los agentes desde Telegram)
# 1. Crea un bot con @BotFather en Telegram
# 2. TELEGRAM_TOKEN es el token que te da BotFather
# 3. TELEGRAM_CHAT_ID es tu chat ID (usa @userinfobot para obtenerlo)
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# ── LiveKit Voice Agent ──
# LIVEKIT_URL=wss://your-livekit-server.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CARTESIA_API_KEY=
# DEEPGRAM_API_KEY=
